                </TimetabledPassingTime>
              </passingTimes>
            </ServiceJourney>

            <ServiceJourney id="NP:ServiceJourney:R10_1238" version="1">
              <Name>Oslo S -&gt; Hamar</Name>
              <JourneyPatternRef ref="NP:JourneyPattern:R10_OSL_HMR"/>
              <PublicCode>1238</PublicCode>
              <LineRef ref="NP:Line:R10"/>
              <passingTimes>
                <TimetabledPassingTime id="NP:TimetabledPassingTime:1238_1" version="1">
                  <StopPointInJourneyPatternRef ref="NP:StopPointInJourneyPattern:R10_OSL_HMR_1"/>
                  <DepartureTime>10:02:00</DepartureTime>
                </TimetabledPassingTime>
                <TimetabledPassingTime id="NP:TimetabledPassingTime:1238_4" version="1">
                  <StopPointInJourneyPatternRef ref="NP:StopPointInJourneyPattern:R10_OSL_HMR_4"/>
                  <ArrivalTime>11:20:00</ArrivalTime>
                </TimetabledPassingTime>
              </passingTimes>
            </ServiceJourney>

            <!-- ===== Dated instances (DatedServiceJourney) - all planned ===== -->

            <DatedServiceJourney id="NP:DatedServiceJourney:1234_2026-11-14" version="1">
              <!-- ServiceAlteration omitted: planned -->
              <ServiceJourneyRef ref="NP:ServiceJourney:R10_1234"/>
              <OperatingDayRef ref="NP:OperatingDay:2026-11-14"/>
            </DatedServiceJourney>

            <DatedServiceJourney id="NP:DatedServiceJourney:1236_2026-11-14" version="1">
              <ServiceJourneyRef ref="NP:ServiceJourney:R10_1236"/>
              <OperatingDayRef ref="NP:OperatingDay:2026-11-14"/>
            </DatedServiceJourney>

            <DatedServiceJourney id="NP:DatedServiceJourney:1238_2026-11-14" version="1">
              <ServiceJourneyRef ref="NP:ServiceJourney:R10_1238"/>
              <OperatingDayRef ref="NP:OperatingDay:2026-11-14"/>
            </DatedServiceJourney>

          </vehicleJourneys>
        </TimetableFrame>

      </frames>
    </CompositeFrame>
  </dataObjects>
</PublicationDelivery>
