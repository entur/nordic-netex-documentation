## -----------------------------------------------------------------
## NeTEx Nordic Documentation Layer
## -----------------------------------------------------------------
## ROLE: Pure documentation metadata — maps each class to its
##       description file, table file, and XML example in the repo.
##       Also assigns profile scope (NordicProfile, EnturExtension,
##       NordicCandidate) to each object.
##
## This file contains NO model logic. It only adds doc: and
## profile:scope annotations to classes defined in the other files.
##
## Usage: import alongside netex-nordic.ttl for full documentation
## links for LLM navigation and tooling.
##
## Generated: 2026-06-16
## -----------------------------------------------------------------

@prefix netex:   <https://netex-cen.eu/ontology#> .
@prefix profile: <https://netex-cen.eu/profile#> .
@prefix doc:     <https://netex-cen.eu/doc#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

## --- Ontology declaration ---
<https://netex-cen.eu/ontology/nordic-documentation> a owl:Ontology ;
    owl:imports <https://netex-cen.eu/profile/nordic> ;
    rdfs:label "NeTEx Nordic Documentation Layer" ;
    rdfs:comment "Adds doc:description, doc:table, doc:example, and profile:scope to ontology classes." .

## --- Documentation vocabulary ---
doc:description a owl:AnnotationProperty ;
    rdfs:label "description" ;
    rdfs:comment "Relative path to the Description markdown file" .

doc:table a owl:AnnotationProperty ;
    rdfs:label "table" ;
    rdfs:comment "Relative path to the Table markdown file (element/attribute spec)" .

doc:example a owl:AnnotationProperty ;
    rdfs:label "example" ;
    rdfs:comment "Relative path to an XML example file" .

## --- Scope vocabulary ---
profile:scope a owl:AnnotationProperty ;
    rdfs:label "scope" ;
    rdfs:comment "Which profile level governs this object" .

profile:NordicProfile a profile:Scope ;
    rdfs:label "Nordic Profile" ;
    skos:definition "Officially part of the Nordic NeTEx Profile" .

profile:EnturExtension a profile:Scope ;
    rdfs:label "Entur Extension" ;
    skos:definition "Entur-specific implementation not yet in the Nordic Profile. Defined in netex-entur.ttl." .

profile:NordicCandidate a profile:Scope ;
    rdfs:label "Nordic Profile Candidate" ;
    skos:definition "Proposed for Nordic Profile harmonisation, currently Entur-driven" .

